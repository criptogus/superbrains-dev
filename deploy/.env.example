# Copy to deploy/.env on the server and fill in. Never commit .env.

# Stripe — get keys at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...   # from `stripe listen` or Dashboard → Webhooks
STRIPE_PRICE_GROWTH=price_...     # $29/mo product price id
STRIPE_PRICE_SCALE=price_...     # $99/mo product price id

# Resend — transactional email for magic links. https://resend.com
RESEND_API_KEY=re_...
RESEND_FROM=SuperBrains <login@superbrains.dev>

# Optional overrides
# APP_URL=https://superbrains.dev
# FREE_FORECAST_LIMIT=5
# ALLOWED_ORIGINS=https://superbrains.dev,https://www.superbrains.dev
# SITE_ADDRESS=superbrains.dev
