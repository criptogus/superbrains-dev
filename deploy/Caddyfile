# Same-origin deploy: static site + /api/* proxy → forecast backend
# $SITE_ADDRESS comes from the container env (default: superbrains.dev)

{$SITE_ADDRESS:superbrains.dev} {
	root * /srv/www
	encode zstd gzip

	# /api/forecast → backend /forecast (prefix stripped)
	@api path /api/*
	handle @api {
		uri strip_prefix /api
		reverse_proxy api:8000
	}

	# cheap health passthrough for uptime checks
	@health path /health
	handle @health {
		reverse_proxy api:8000
	}

	file_server
}
